#!/bin/bash
# rasora: the command you actually type.
set -uo pipefail
BIN="$HOME/.rasora/bin"
PY="$BIN/.venv-cdp/bin/python"
ICI="$(cd "$(dirname "$0")" && pwd)"

# First use, from the plugin: set up without asking anything.
[ -x "$PY" ] || bash "$ICI/bootstrap.sh" >/dev/null || { echo "setup failed: bash $ICI/bootstrap.sh" >&2; exit 1; }
[ -s "$HOME/.rasora/port" ] && CDP_PORT="$(cat "$HOME/.rasora/port")"
export CDP_PORT="${CDP_PORT:-9333}"
PORT="$CDP_PORT"

aide() {
  cat <<'FIN'
rasora: hands and a memory for your AI.

Accounts
  rasora login <url>        open a window, sign in once by hand, it hides itself after
  rasora logout <site>      sign out and delete that site's cookies
  rasora sites              sites you signed in to
  rasora sessions           check that they are still signed in

Web, cheapest way first
  rasora search <words>     search the web
  rasora get <url> [n]      read a page, Chrome only if needed

Browser, for signed-in sites
  rasora start | stop       start or stop the separate Chrome
  rasora show | hide        bring its windows on screen, or hide them
  rasora tabs               list tabs
  rasora open <url>         open a page
  rasora read [tab] [n]     read a page
  rasora elements [tab]     list what can be clicked
  rasora click <tab> <text> click visible text
  rasora fill <tab> <label> <value>
  rasora press <tab> <Enter|Escape|Tab>
  rasora wait <tab> <text> [seconds]
  rasora screenshot <tab> <name>

Work in the background
  rasora do "<task>"        run a task with your Claude Code subscription
  rasora jobs               list tasks
  rasora job <id>           show what a task did

Memory
  rasora remember <site|general> <text>
  rasora recall <words...>

For other agents
  rasora mcp                run the MCP server on stdio

Safety
  rasora pause              freeze everything now
  rasora resume             start again

Cleanup
  rasora wipe               stop everything and delete all of it, cookies and memory

A tab is part of its URL, or #id from `tabs`.
FIN
}

allume() { curl -s --max-time 2 "http://127.0.0.1:$PORT/json/version" >/dev/null 2>&1; }
assure() { [ ! -e "$HOME/.rasora/paused" ] || { echo "paused. Run: rasora resume" >&2; exit 1; }; allume || "$BIN/navigateur-bot.sh" >/dev/null 2>&1 || { echo "the browser did not start" >&2; exit 1; }; }

effacer() {
  if [ "${1:-}" != "--yes" ]; then
    echo "This stops rasora and deletes ~/.rasora: the bot profile, its cookies, its logs."
    echo "Your own Chrome is not touched."
    printf "Type wipe to confirm: "
    read -r reponse </dev/tty || exit 1
    [ "$reponse" = "wipe" ] || { echo "cancelled"; exit 1; }
  fi
  for f in "$HOME"/Library/LaunchAgents/com.rasora.*.plist; do
    [ -e "$f" ] || continue
    launchctl unload "$f" >/dev/null 2>&1
    rm -f "$f"
  done
  "$BIN/navigateur-bot.sh" --arret >/dev/null 2>&1
  sleep 1
  pgrep -f "user-data-dir=$HOME/.rasora/chrome-profile" 2>/dev/null | xargs kill -9 2>/dev/null
  rm -rf "$HOME/.claude/skills/rasora" "$HOME/.local/bin/rasora"
  cd "$HOME" && rm -rf "$HOME/.rasora"
  echo "rasora data is gone. Your own Chrome was not touched."
  command -v claude >/dev/null && echo "To remove the plugin too: claude plugin uninstall rasora"
}

lancer() { # the task, run by the user's own Claude Code
  command -v claude >/dev/null || { echo "Claude Code not found. Install it, or use: rasora mcp" >&2; exit 1; }
  [ $# -gt 0 ] || { echo 'usage: rasora do "<task>"' >&2; exit 1; }
  local id; id="$(date +%m%d-%H%M%S)"
  mkdir -p "$HOME/.rasora/jobs"
  local log="$HOME/.rasora/jobs/$id.log"
  echo "$*" > "$HOME/.rasora/jobs/$id.task"
  local m=(); [ -n "${RASORA_MODEL:-}" ] && m=(--model "$RASORA_MODEL")
  ( cd "$HOME" && PATH="$BIN:$PATH" nohup claude -p "$*" \
      "${m[@]+"${m[@]}"}" --allowedTools "Bash(rasora:*)" "mcp__plugin_rasora_rasora" >"$log" 2>&1 </dev/null
    echo "[finished]" >>"$log" ) &
  disown
  echo "started $id"
  echo "follow it with: rasora job $id"
}

taches() {
  for f in "$HOME"/.rasora/jobs/*.task; do
    [ -e "$f" ] || { echo "no task yet"; return; }
    local id; id="$(basename "$f" .task)"
    local etat=running; tail -1 "${f%.task}.log" 2>/dev/null | grep -q '^\[finished\]$' && etat=done
    printf "%s  %-8s %s\n" "$id" "$etat" "$(head -c 70 "$f")"
  done
}

c="${1:-help}"
[ $# -gt 0 ] && shift
mkdir -p "$HOME/.rasora/state" 2>/dev/null; : > "$HOME/.rasora/state/last-use" 2>/dev/null
case "$c" in
  help|-h|--help) aide ;;
  start)   "$BIN/navigateur-bot.sh" ;;
  stop)    "$BIN/navigateur-bot.sh" --arret ;;
  sites)   "$PY" "$BIN/configurer-sessions.py" list ;;
  login)   "$PY" "$BIN/sensibles.py" check-url "${1:-}" || exit 1; assure; exec "$PY" "$BIN/connexion.py" "$@" ;;
  logout)  assure; "$PY" "$BIN/configurer-sessions.py" remove "$@" ;;
  sessions) assure; "$PY" "$BIN/sessions.py" etat ;;
  mcp)     exec "$PY" "$BIN/mcp_server.py" ;;
  do)      assure; lancer "$@" ;;
  jobs)    taches ;;
  job)     cat "$HOME/.rasora/jobs/${1:?usage: rasora job <id>}.log" ;;
  remember) "$PY" "$BIN/memoire.py" save "$@" ;;
  recall)  "$PY" "$BIN/memoire.py" search "$@" ;;
  search)  "$PY" "$BIN/web.py" search "$@" ;;
  get)     "$PY" "$BIN/web.py" get "$@" ;;
  pause)   touch "$HOME/.rasora/paused"; "$BIN/navigateur-bot.sh" --arret; echo "paused" ;;
  resume)  rm -f "$HOME/.rasora/paused"; echo "resumed" ;;
  open|ouvrir)
    "$PY" "$BIN/sensibles.py" check-url "${1:-}" || exit 1
    assure
    "$PY" "$BIN/nav.py" open "$@"; rc=$?
    "$PY" "$BIN/memoire.py" show "${1:-general}"
    exit $rc ;;
  wipe)    effacer "$@" ;;
  *)       assure; exec "$PY" "$BIN/nav.py" "$c" "$@" ;;
esac
